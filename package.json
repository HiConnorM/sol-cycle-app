{
  "name": "sol-cycle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "TZ=America/Los_Angeles vitest run",
    "test:watch": "TZ=America/Los_Angeles vitest",
    "test:tz": "for tz in America/Los_Angeles America/New_York UTC Europe/Berlin Asia/Tokyo Pacific/Kiritimati; do echo \"── $tz ──\"; TZ=$tz vitest run || exit 1; done",
    "typecheck": "tsc --noEmit",
    "ios:assets": "node scripts/generate-ios-assets.mjs",
    "ios:sync": "pnpm build && cap sync ios && pnpm ios:configure && pnpm ios:assets",
    "ios:open": "cap open ios",
    "ios:run": "pnpm ios:sync && cap run ios",
    "ios:configure": "bash scripts/configure-ios.sh",
    "bench": "TZ=America/Los_Angeles vitest run --config vitest.bench.config.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.564.0",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.0",
    "postcss": "^8.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vitest": "^2.1.8"
  }
}
